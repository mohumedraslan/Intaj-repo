# Staging Environment Configuration for Intaj AI Platform
# DO NOT COMMIT THIS FILE TO VERSION CONTROL

# Application Configuration
NODE_ENV=staging
PORT=3000
APP_NAME=intaj-staging
APP_VERSION=1.0.0-staging
APP_DOMAIN=staging.intaj.ai
APP_URL=https://staging.intaj.ai

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1
NEXTAUTH_URL=https://staging.intaj.ai
NEXTAUTH_SECRET=your-nextauth-secret-staging

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_PROJECT_ID=your-staging-project-id
SUPABASE_ACCESS_TOKEN=your-staging-access-token

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/intaj_staging
POSTGRES_HOST=your-staging-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=intaj_staging
POSTGRES_USER=intaj_staging_user
POSTGRES_PASSWORD=your-staging-postgres-password

# Redis Configuration
REDIS_URL=redis://user:password@host:6379
REDIS_HOST=your-staging-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-staging-redis-password

# OpenRouter Configuration
OPENROUTER_API_KEY=your-staging-openrouter-api-key

# OpenAI Configuration (Fallback)
OPENAI_API_KEY=your-staging-openai-api-key

# Anthropic Configuration (Fallback)
ANTHROPIC_API_KEY=your-staging-anthropic-api-key

# Stripe Configuration (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-test-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-test-webhook-secret

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-staging-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-staging-telegram-webhook-secret

# WhatsApp Configuration
WHATSAPP_ACCESS_TOKEN=your-staging-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-staging-whatsapp-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-staging-phone-number-id

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=staging@intaj.ai
SMTP_PASSWORD=your-staging-smtp-password
FROM_EMAIL=staging@intaj.ai

# Monitoring Configuration
PROMETHEUS_PASSWORD=your-staging-prometheus-password
GRAFANA_PASSWORD=your-staging-grafana-password
ALERTMANAGER_PASSWORD=your-staging-alertmanager-password

# Slack Integration (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/staging/webhook

# Sentry Configuration (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-staging-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=intaj-staging

# Analytics Configuration
GOOGLE_ANALYTICS_ID=GA-STAGING-XXXXXXXXX
MIXPANEL_TOKEN=your-staging-mixpanel-token

# Security Configuration
JWT_SECRET=your-staging-jwt-secret
ENCRYPTION_KEY=your-staging-32-character-encryption-key
API_RATE_LIMIT_MAX=200
API_RATE_LIMIT_WINDOW=900000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_RATE_LIMITING=false
ENABLE_CACHING=true
ENABLE_COMPRESSION=true

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# Docker Registry
DOCKER_REGISTRY=ghcr.io/intaj

# Kubernetes Configuration
KUBE_NAMESPACE=intaj-staging
HELM_RELEASE_NAME=intaj-app-staging

# Backup Configuration
BACKUP_SCHEDULE=0 4 * * *
BACKUP_RETENTION_DAYS=7
S3_BACKUP_BUCKET=intaj-backups-staging

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/staging.intaj.crt
SSL_KEY_PATH=/etc/ssl/private/staging.intaj.key

# CORS Configuration
CORS_ORIGINS=https://staging.intaj.ai,https://www.staging.intaj.ai

# CDN Configuration
CDN_URL=https://staging-cdn.intaj.ai

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,csv,json

# Rate Limiting Configuration
RATE_LIMIT_REDIS_URL=redis://user:password@host:6379/1
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# Session Configuration
SESSION_SECRET=your-staging-session-secret
SESSION_TIMEOUT=86400000

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PATH=/api/v1/metrics
BUSINESS_METRICS_ENABLED=true
