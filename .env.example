# Intaj Platform Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ==============================================
# CORE APPLICATION SETTINGS
# ==============================================
NEXT_PUBLIC_APP_NAME=Intaj
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================
# VECTOR DATABASE (QDRANT)
# ==============================================
# Local Qdrant instance
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Qdrant Cloud (alternative to local)
# QDRANT_HOST=your-cluster-url.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ==============================================
# REDIS CACHE
# ==============================================
# Local Redis
REDIS_URL=redis://localhost:6379

# Redis Cloud (alternative)
# REDIS_URL=redis://username:password@host:port

# ==============================================
# LLM PROVIDERS
# ==============================================

# OpenRouter (Primary LLM Provider)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_APP_NAME=Intaj

# OpenAI (For embeddings and direct API)
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-openai-organization-id

# Anthropic (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ==============================================
# MESSAGING INTEGRATIONS
# ==============================================

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-webhook-verify-token

# ==============================================
# PAYMENT PROCESSING
# ==============================================
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ==============================================
# EMAIL SERVICES
# ==============================================
# Resend (Email API)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ==============================================
# MONITORING & ANALYTICS
# ==============================================
# Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
NODE_ENV=development
LOG_LEVEL=info

# Enable debug modes
DEBUG_LLM=false
DEBUG_RAG=false
DEBUG_VECTOR_DB=false
DEBUG_EMBEDDINGS=false

# ==============================================
# PERFORMANCE TUNING
# ==============================================
# Vector Database Settings
VECTOR_DB_BATCH_SIZE=100
VECTOR_DB_CONNECTION_POOL_SIZE=10

# Embedding Settings
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CACHE_TTL=604800
EMBEDDING_MAX_RETRIES=3

# LLM Settings
LLM_REQUEST_TIMEOUT=120000
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_RPM=60

# Cache Settings
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=1000

# ==============================================
# SECURITY SETTINGS
# ==============================================
# JWT Settings
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# ==============================================
# FILE UPLOAD SETTINGS
# ==============================================
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv,text/markdown,application/json,text/html,text/xml

# ==============================================
# WEBHOOK SETTINGS
# ==============================================
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# ==============================================
# DATABASE SETTINGS
# ==============================================
# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=2000

# ==============================================
# FEATURE FLAGS
# ==============================================
FEATURE_RAG_ENABLED=true
FEATURE_VECTOR_SEARCH_ENABLED=true
FEATURE_HYBRID_SEARCH_ENABLED=true
FEATURE_DOCUMENT_VERSIONING_ENABLED=true
FEATURE_USAGE_ANALYTICS_ENABLED=true
FEATURE_PERFORMANCE_MONITORING_ENABLED=true

# ==============================================
# THIRD-PARTY SERVICES
# ==============================================
# Google Services (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==============================================
# DEPLOYMENT SETTINGS
# ==============================================
# Vercel (if deploying to Vercel)
VERCEL_URL=your-vercel-deployment-url

# Docker Settings
DOCKER_REGISTRY=your-docker-registry
DOCKER_IMAGE_TAG=latest

# ==============================================
# BACKUP & RECOVERY
# ==============================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_FORMAT=json
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m
LOG_DATE_PATTERN=YYYY-MM-DD

# ==============================================
# HEALTH CHECK SETTINGS
# ==============================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# ==============================================
# NOTES
# ==============================================
# 1. Never commit this file with real values to version control
# 2. Use strong, unique passwords and API keys
# 3. Rotate API keys regularly
# 4. Use environment-specific values for different deployments
# 5. Consider using a secret management service for production
# 6. Test all integrations in development before deploying
# 7. Monitor usage and costs regularly
# 8. Keep this file updated as new features are added
