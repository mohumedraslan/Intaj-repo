# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/intaj_production
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=intaj_production
POSTGRES_USER=intaj_user
POSTGRES_PASSWORD=your-postgres-password

# Redis Configuration
REDIS_URL=redis://user:password@host:6379
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI Configuration (Fallback)
OPENAI_API_KEY=your-openai-api-key

# Anthropic Configuration (Fallback)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# WhatsApp Configuration
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@intaj.ai
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@intaj.ai

# Monitoring Configuration
PROMETHEUS_PASSWORD=your-prometheus-password
GRAFANA_PASSWORD=your-grafana-password
ALERTMANAGER_PASSWORD=your-alertmanager-password

# Slack Integration (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# PagerDuty Integration (for critical alerts)
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# Sentry Configuration (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=intaj

# Analytics Configuration
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# Security Configuration
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-32-character-encryption-key
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW=900000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_COMPRESSION=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# Docker Registry
DOCKER_REGISTRY=ghcr.io/intaj

# Kubernetes Configuration
KUBE_NAMESPACE=intaj-production
HELM_RELEASE_NAME=intaj-app

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=intaj-backups-production

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/intaj.crt
SSL_KEY_PATH=/etc/ssl/private/intaj.key

# CORS Configuration
CORS_ORIGINS=https://intaj.ai,https://www.intaj.ai,https://app.intaj.ai

# CDN Configuration
CDN_URL=https://cdn.intaj.ai

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,csv,json

# Rate Limiting Configuration
RATE_LIMIT_REDIS_URL=redis://user:password@host:6379/1
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_TIMEOUT=86400000

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PATH=/api/v1/metrics
BUSINESS_METRICS_ENABLED=true
